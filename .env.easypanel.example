# Public endpoints (no trailing slash)
APP_URL=https://app.example.com
LIVEKIT_PUBLIC_URL=wss://livekit.example.com

# Generated secrets. Run `npm run easypanel:env -- app.example.com livekit.example.com`
# to produce safe values instead of using these placeholders.
POSTGRES_DB=nexocam
POSTGRES_USER=nexocam
POSTGRES_PASSWORD=replace-with-url-safe-random-value
REDIS_PASSWORD=replace-with-url-safe-random-value
BETTER_AUTH_SECRET=replace-with-base64-encoded-32-byte-value
LIVEKIT_API_KEY=nexocam_prod
LIVEKIT_API_SECRET=replace-with-random-value
S3_REGION=us-east-1
S3_BUCKET=nexocam-evidence
S3_ACCESS_KEY=nexocam
S3_SECRET_KEY=replace-with-random-value
EVIDENCE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-value
MODERATION_SERVICE_TOKEN=replace-with-random-value

# Capacity and CPU moderation
MAX_CONCURRENT_USERS=100
SAMPLE_SECONDS=3
NSFW_WARNING_THRESHOLD=0.68
NSFW_STRONG_THRESHOLD=0.88
MAX_CONCURRENT_INFERENCE=2
ONNX_THREADS=2

# Email verification. Without SMTP, verification links are printed in app logs.
SMTP_URL=
EMAIL_FROM=NexoCam <noreply@example.com>

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

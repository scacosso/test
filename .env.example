# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DEMO_MODE=true
MAX_CONCURRENT_USERS=100

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SUPERUSER_EMAILS=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=NexoCam <noreply@nexocam.local>
# Email verification is disabled by the default database feature flag.

# PostgreSQL / Redis
DATABASE_URL=postgresql://nexocam:nexocam@postgres:5432/nexocam
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=nexocam
POSTGRES_USER=nexocam
POSTGRES_PASSWORD=change-me

# LiveKit
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-32-random-characters

# Evidence / MinIO — encryption key must decode to exactly 32 bytes
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nexocam-evidence
S3_ACCESS_KEY=nexocam
S3_SECRET_KEY=change-me-too
EVIDENCE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
MODERATION_SERVICE_TOKEN=replace-with-random-internal-token

# CPU moderation
SAMPLE_SECONDS=3
NSFW_WARNING_THRESHOLD=0.68
NSFW_STRONG_THRESHOLD=0.88
MAX_CONCURRENT_INFERENCE=2
ONNX_THREADS=2
HEALTH_PORT=8081
API_INTERNAL_URL=http://app:3001
